{
  "name": "autoll-6",
  "version": "1.9.1",
  "description": "An unofficial, experimental Lightning Lane assistant",
  "license": "GPL-3.0-only",
  "repository": "github:mbs1234/AutoLL-6",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-testing-library": "^7.6.3",
    "globals": "^16.3.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.0.5",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  },
  "scripts": {
    "start": "vite",
    "start:lan": "vite --host 0.0.0.0",
    "harness": "vite --config vite.harness.config.mts",
    "harness:lan": "vite --config vite.harness.config.mts --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "checkall": "npm run test:ci && npm run lint && npm run typecheck",
    "test": "TZ=UTC jest",
    "test:ci": "TZ=UTC jest --ci",
    "coverage": "jest --coverage --coverageDirectory=.coverage",
    "lint": "eslint src harness",
    "lint:fix": "eslint --fix src harness",
    "format": "prettier --write src harness",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    ">0.5%",
    "not dead",
    "not OperaMini all"
  ],
  "overrides": {
    "rollup": "4.59.0"
  }
}
